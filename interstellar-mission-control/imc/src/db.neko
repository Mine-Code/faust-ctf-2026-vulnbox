var createMission = function(name, milestones, spaceships, planets, deadline, sponsor, reward, overseer){
	if(name == "" || deadline == "" || sponsor == "" || reward == "") return -1;
	var amalg = name+milestones+spaceships+planets+deadline+sponsor+reward+overseer;
	if($not(checkInput(amalg))) return -2;
	var sql = "INSERT INTO MISSIONS (name, milestones, spaceships, planets, deadline, sponsor, reward, overseer, timestamp) VALUES (\""+ name + "\",\"" + milestones + "\",\"" + spaceships + "\",\"" + planets + "\"," + deadline + "," + sponsor + ",\"" + reward + "\"," + overseer +"," + getCurTime() + ");";
	try{
		var res = sqlite_request(db, sql);
		sqlite_result_next(res);
		return sqlite_result_get_length(res);
	} catch e {
                log_err(e);
		return -3;
	}
}
$exports.createMission = createMission;

var updateByName = function(table, name, attr, nval){
	var amalg = table+name+attr+nval;
	if($not(isColumnOf(table, attr))) return -1;
	if($not(checkInput(amalg))) return -2;
	var sql = "UPDATE " + table + " SET " + attr + " = \"" + nval + "\" WHERE name LIKE \"" + name + "\";";
	try{
		var res = sqlite_request(db, sql);
		sqlite_result_next(res);
		return sqlite_result_get_length(res);
	} catch e {
		return -3;
	}
}
$exports.updateByName = updateByName;

var updateById = function(table, id, attr, nval){
	var amalg = table+id+attr+nval;
	if($not(isColumnOf(table, attr))) return -1;
	if($not(checkInput(amalg))) return -2;
	var sql = "UPDATE " + table + " SET " + attr + " = \"" + nval + "\" WHERE id = " + $int(id) + ";";
	try{
		var res = sqlite_request(db, sql);
		sqlite_result_next(res);
		return sqlite_result_get_length(res);
	} catch e {
		return -3;
	}
}
$exports.updateById = updateById;


var getByName = function(table, name){
	var amalg = name+table;
	if($not(checkInput(amalg))) return -2;
	var sql = "SELECT * FROM " + table + " WHERE name = \"" + name + "\";";
	var res;
	var row;
	try{
		res = sqlite_request(db, sql);
		row = sqlite_result_next(res);
		while(sqlite_result_next(res) != null){}
	} catch e {
		return -3;
	}
	return row;
}
$exports.getByName = getByName;

var fetchByFields = function(table, cols, whereCols, whereVals){
	var i = 0;
	while(i < $asize(whereVals)){
		if($not(checkInput(whereVals[i]))) return null;
		i = i+1;
	}

	var collist = "";
	i = 0;
	while(i < $asize(cols)){
		if(i > 0) collist = collist + ", ";
		collist = collist + cols[i];
		i = i+1;
	}

	var where = "";
	i = 0;
	while(i < $asize(whereCols)){
		if(i > 0) where = where + " AND ";
		where = where + whereCols[i] + " LIKE \"" + whereVals[i] + "\"";
		i = i+1;
	}

	var sql = "SELECT " + collist + " FROM " + table;
	if($asize(whereCols) > 0) sql = sql + " WHERE " + where;
	sql = sql + ";";

	var res;
	var rows = $amake(0);
	try{
		res = sqlite_request(db, sql);
		var row = sqlite_result_next(res);
		while(row != null){
			rows = $aconcat($array(rows, $array(row)));
			row = sqlite_result_next(res);
		}
	} catch e {
		return null;
	}
	return rows;
}
$exports.fetchByFields = fetchByFields;

var getById = function(table, id){
	if($typeof(id) != $tint){
            return null;
        }
	var sql = "SELECT * FROM " + table + " WHERE id = " + id + ";";
	var res;
	var row;
	try{
		res = sqlite_request(db, sql);
		row = sqlite_result_next(res);
		while(sqlite_result_next(res) != null){}
	} catch e {
		return null;
	}
	return row;
}
$exports.getById = getById;
