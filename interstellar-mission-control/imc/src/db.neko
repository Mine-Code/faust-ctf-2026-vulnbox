var createSpaceship = function(name, location, fuel, max_speed, tuv, manufacturer, crew, resources, capacity, janitor){
	if(name == "" || tuv == "" || manufacturer == "" || capacity == "") return -1;
	var amalg = name+location+fuel+max_speed+tuv+manufacturer+crew+resources+capacity+janitor;
	if($not(checkInput(amalg))) return -2;
	var sql = "INSERT INTO SPACESHIPS (name, location, fuel, max_speed, tuv, manufacturer, crew, resources, capacity, janitor, timestamp) VALUES ( \""+ name + "\",\"" + location + "\"," + fuel + "," + max_speed + ",\"" + tuv + "\",\"" + manufacturer + "\"," + crew + ",\"" + resources + "\"," + capacity + "," + janitor + "," + getCurTime() + ");";
	try{
		var res = sqlite_request(db, sql);
