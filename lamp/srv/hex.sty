\newcommand{\unhex}[2]{
  \edef\tmp{#1}
  \gdef#2{}
  \loop
  \unless\ifx\tmp\empty
    \StrLeft{\tmp}{1}[\numa]
    \StrGobbleLeft{\tmp}{1}[\tmp]
    \StrLeft{\tmp}{1}[\numb]
    \StrGobbleLeft{\tmp}{1}[\tmp]
    \edef\a{\csname hex\numa\endcsname}
    \edef\b{\csname hex\numb\endcsname}
    \FPeval\n{clip(\a*16+\b)}
    \xdef#2{#2\Uchar\n}
  \repeat
}

\newcommand{\ifhexchar}[3]{
  \begingroup
  \edef\tmp{#1}
  \StrLen{\tmp}[\len]
  \ifnum\len=2
    \StrLeft{\tmp}{1}[\numa]
    \StrRight{\tmp}{1}[\numb]
    \expandafter\ifdefined\csname hex\numa\endcsname
      \expandafter\ifdefined\csname hex\numb\endcsname
        #2
      \else
        #3
      \fi
    \else
      #3
    \fi
  \else
    #3
  \fi
  \endgroup
}
