\usepackage{xstring}
\usepackage{fp}

\newcommand{\defhex}[2]{
  \expandafter\xdef\csname hex#1\endcsname{#2}
}
\defhex{0}{0}
\defhex{1}{1}
\defhex{2}{2}
\defhex{3}{3}
\defhex{4}{4}
\defhex{5}{5}
\defhex{6}{6}
\defhex{7}{7}
\defhex{8}{8}
\defhex{9}{9}
\defhex{a}{10}
\defhex{b}{11}
\defhex{c}{12}
\defhex{d}{13}
\defhex{e}{14}
\defhex{f}{15}
\defhex{A}{10}
